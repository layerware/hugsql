{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.8.0"}
        org.clojure/tools.reader {:mvn/version "1.3.6"}
        com.layerware/hugsql-adapter {:local/root "../hugsql-adapter"}}
 :aliases
 {;; clojure -M:test-cljs runs the .cljc tests under test/ on Node
  :test-cljs {:extra-paths ["test"]
              :extra-deps {org.clojure/clojure {:mvn/version "1.11.4"}
                           org.clojure/clojurescript {:mvn/version "1.11.132"}
                           olical/cljs-test-runner {:mvn/version "3.8.1"}}
              :main-opts ["-m" "cljs-test-runner.main" "-d" "test"]}}}
